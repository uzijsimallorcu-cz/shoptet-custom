# Povinné
FREELO_API_TOKEN=replace-with-real-token

# Výchozí base URL (uprav dle dokumentace, pokud používáš jinou verzi)
FREELO_API_BASE_URL=https://api.freelo.io/v1

# Pokud je potřeba jiné auth schéma než Bearer
FREELO_AUTH_HEADER=Authorization
FREELO_AUTH_SCHEME=Bearer

# Paginace (uprav dle API dokumentace)
FREELO_PAGE_PARAM=page
FREELO_PER_PAGE_PARAM=per_page
FREELO_PER_PAGE_VALUE=100
FREELO_MAX_PAGES=1000

# Technické parametry
FREELO_PAUSE_MS=50
FREELO_TIMEOUT_S=30
